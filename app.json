{
  "expo": {
    "name": "chefin_app",
    "slug": "chefin_app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "",
    "scheme": "chefinapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Chefin to choose photos for your profile, dishes, and order updates.",
          "cameraPermission": "Allow Chefin to take dish and order photos."
        }
      ],
      [
        "expo-navigation-bar",
        {
          "hidden": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
