EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Use the development computer's LAN IP so physical devices can reach port 8000.
EXPO_PUBLIC_API_URL=http://192.168.x.x:8000
CORS_ALLOWED_ORIGINS=http://localhost:8081
EXPO_PUBLIC_SUPPORT_EMAIL=support@chefin.app
ADMIN_INVITE_REDIRECT_URL=http://localhost:8081/setup-password
RESEND_API_KEY=re_your_api_key
ADMIN_FROM_EMAIL=Chefin Support <support@your-domain.com>

# Server-only Lalamove credentials. Start in sandbox, then switch to production
# after the webhook URL is public and production credentials are approved.
LALAMOVE_API_KEY=your-lalamove-api-key
LALAMOVE_API_SECRET=your-lalamove-api-secret
LALAMOVE_ENVIRONMENT=sandbox
LALAMOVE_MARKET=MY
LALAMOVE_SERVICE_TYPE=MOTORCYCLE
LALAMOVE_WEBHOOK_PATH=/api/delivery/lalamove/webhook
